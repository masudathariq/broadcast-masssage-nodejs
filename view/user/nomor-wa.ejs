<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Daftar Nomor WhatsApp</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
  <style>
    body {
      background: linear-gradient(to bottom, #f0f8f7, #e2e8f0);
      min-height: 100vh;
    }
    .btn-custom {
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .btn-custom:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
    }
    .table-card {
      background: white;
      border-radius: 1rem;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
      overflow: hidden;
    }
    .table-row:hover {
      background-color: #f1f5f9;
      transition: background-color 0.3s;
    }
    .footer {
      background: linear-gradient(to top, #1e3a8a, #3b82f6);
      color: white;
      clip-path: polygon(0 20%, 100% 0, 100% 100%, 0 100%);
    }
  </style>
</head>
<body class="font-sans antialiased">
  <div class="container mx-auto px-4 py-8">
    <!-- Judul -->
    <div class="flex items-center mb-6">
      <i class="fas fa-phone-alt text-4xl text-blue-600 mr-4"></i>
      <h2 class="text-3xl font-bold text-gray-800">Daftar Nomor WhatsApp</h2>
    </div>

    <!-- Tombol Navigasi -->
    <div class="flex flex-wrap gap-4 mb-8">
      <a href="/dashboard" class="btn-custom bg-gray-600 text-white px-6 py-3 rounded-lg hover:bg-gray-700 flex items-center">
        <i class="fas fa-arrow-left mr-2"></i> Kembali ke Dashboard
      </a>
      <a href="/user/nomor-wa/tambah" class="btn-custom bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 flex items-center">
        <i class="fas fa-plus mr-2"></i> Tambah Nomor WA
      </a>
      <a href="/user/nomor-wa" class="btn-custom bg-gray-300 text-gray-800 px-6 py-3 rounded-lg hover:bg-gray-400 flex items-center">
        <i class="fas fa-sync-alt mr-2"></i> Refresh Status
      </a>
    </div>

    <!-- Tabel Session WhatsApp -->
    <div class="table-card">
      <table class="w-full text-left">
        <thead class="bg-blue-600 text-white">
          <tr>
            <th class="p-4">No</th>
            <th class="p-4">Session Name</th>
            <th class="p-4">Status</th>
            <th class="p-4">Terhubung Sejak</th>
            <th class="p-4">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (!sessions || sessions.length === 0) { %>
            <tr class="table-row">
              <td colspan="5" class="p-4 text-center text-gray-500">Belum ada sesi WhatsApp ditambahkan.</td>
            </tr>
          <% } else { %>
            <% sessions.forEach((session, index) => { %>
              <tr class="table-row border-b">
                <td class="p-4"><%= index + 1 %></td>
                <td class="p-4"><%= session.sessionName || '-' %></td>
                <td class="p-4" id="status-<%= session.sessionName.replace(/[^a-zA-Z0-9_-]/g, '') %>">
                  <% if (session.connected) { %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                      <i class="fas fa-check-circle mr-2"></i> Terhubung
                    </span>
                  <% } else { %>
                    <span class="inline-flex flex-col items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
                      <span><i class="fas fa-times-circle mr-2"></i> Belum Terhubung</span>
                      <a href="/user/nomor-wa/scan/<%= session.sessionName %>" class="text-blue-600 hover:underline mt-1">
                        <i class="fas fa-qrcode mr-1"></i> Scan QR
                      </a>
                    </span>
                  <% } %>
                </td>
                <td class="p-4">
  <% if (session.connectedAt && !isNaN(new Date(session.connectedAt))) { %>
    <%= new Date(session.connectedAt).toLocaleString('id-ID') %>
  <% } else { %>
    <span class="text-gray-500">-</span>
  <% } %>
</td>

                <td class="p-4">
                  <form action="/user/nomor-wa/hapus/<%= session._id %>" method="POST" onsubmit="return confirm('Yakin ingin menghapus sesi ini?')">
                    <button type="submit" class="btn-custom bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600 flex items-center">
                      <i class="fas fa-trash-alt mr-2"></i> Hapus
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Footer -->
  <div class="footer py-12 mt-12 text-center">
    <p class="text-lg">© 2025 Daftar Nomor WhatsApp. All rights reserved.</p>
  </div>

  <!-- Data sessions dari backend -->
  <script id="sessions-data" type="application/json">
    <%= JSON.stringify(sessions.map(s => ({
      sessionName: s.sessionName.replace(/[^a-zA-Z0-9_-]/g, ''),
      originalName: s.sessionName
    }))) %>
  </script>

  <!-- FontAwesome -->
  <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>

  <!-- JS untuk realtime status -->
  <script>
    const sessionList = JSON.parse(document.getElementById('sessions-data').textContent);

    sessionList.forEach(({ sessionName, originalName }) => {
      setInterval(() => {
        fetch(`/user/nomor-wa/status-realtime/${originalName}`)
          .then(res => res.json())
          .then(data => {
            const el = document.getElementById('status-' + sessionName);
            if (!el) return;

            if (data.connected) {
              el.innerHTML = `
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                  <i class="fas fa-check-circle mr-2"></i> Terhubung
                </span>`;
            } else {
              el.innerHTML = `
                <span class="inline-flex flex-col items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
                  <span><i class="fas fa-times-circle mr-2"></i> Belum Terhubung</span>
                  <a href="/user/nomor-wa/scan/${originalName}" class="text-blue-600 hover:underline mt-1">
                    <i class="fas fa-qrcode mr-1"></i> Scan QR
                  </a>
                </span>`;
            }
          })
          .catch(err => console.error('Gagal memuat status:', err));
      }, 3000);
    });
  </script>
</body>
</html>
