<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Scan QR WhatsApp - <%= sessionName %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <!-- ❌ HAPUS AUTO REFRESH - Kita akan pakai JavaScript -->
  
  <style>
    .qr-box {
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .qr-box:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
    }
    .btn-custom {
      transition: transform 0.2s ease, background-color 0.2s ease;
    }
    .btn-custom:hover {
      transform: translateY(-2px);
    }
    .spinner-border {
      animation: spin 1s linear infinite;
    }
    
    /* ✅ Style untuk notifikasi success */
    .success-notification {
      animation: fadeInScale 0.5s ease-out;
    }
    
    @keyframes fadeInScale {
      0% {
        opacity: 0;
        transform: scale(0.9);
      }
      100% {
        opacity: 1;
        transform: scale(1);
      }
    }
    
    .success-icon {
      animation: bounceIn 0.6s ease-out;
    }
    
    @keyframes bounceIn {
      0% {
        opacity: 0;
        transform: scale(0.3);
      }
      50% {
        opacity: 1;
        transform: scale(1.05);
      }
      70% {
        transform: scale(0.9);
      }
      100% {
        opacity: 1;
        transform: scale(1);
      }
    }
  </style>
</head>

<body class="bg-gray-50 min-h-screen flex items-center justify-center">
  <div class="container px-4 py-8">
    <div class="qr-box bg-white rounded-2xl shadow-xl p-8 max-w-md mx-auto text-center">
      <h2 class="text-2xl font-bold text-gray-800 mb-3">Scan QR WhatsApp</h2>
      <p class="text-gray-600 mb-4">Untuk sesi: <strong><%= sessionName %></strong></p>

      <!-- ✅ Container untuk status yang akan diupdate via JavaScript -->
      <div id="status-container">
        <% if (isConnected) { %>
          <!-- Sudah terhubung -->
          <div class="success-notification">
            <div class="success-icon text-6xl text-green-500 mb-4">
              <i class="fas fa-check-circle"></i>
            </div>
            <p class="text-green-700 font-semibold text-lg">
              ✅ Berhasil terhubung ke WhatsApp!
            </p>
            <div class="bg-green-50 text-green-700 text-sm p-4 rounded-lg mt-4">
              <p><i class="fas fa-info-circle mr-2"></i>Koneksi WhatsApp aktif dan siap digunakan.</p>
            </div>
          </div>
        <% } else if (qrImage) { %>
          <!-- Menampilkan QR jika belum terhubung -->
          <div id="qr-section">
            <img src="<%= qrImage %>" alt="QR Code" class="max-w-[250px] mx-auto mb-4 rounded-lg">
            <p class="text-green-600 font-medium mb-3"><i class="fas fa-check-circle mr-2"></i>Silakan scan menggunakan WhatsApp Anda.</p>
            <div class="bg-blue-50 text-blue-700 text-sm p-4 rounded-lg mb-4">
              <p>Buka WhatsApp → Ketuk titik tiga ⋮ → Pilih "Perangkat Tertaut" → Scan QR ini.</p>
            </div>
            <button onclick="refreshQR()" class="btn btn-outline-primary btn-custom inline-flex items-center px-4 py-2 rounded-lg hover:bg-blue-50">
              <i class="fas fa-sync-alt mr-2"></i> Refresh QR Code
            </button>
          </div>
        <% } else { %>
          <!-- Loading spinner saat QR belum tersedia -->
          <div id="loading-section">
            <p class="text-gray-600 mb-4"><i class="fas fa-hourglass-half mr-2"></i>Menyiapkan QR...</p>
            <div class="spinner-border text-success mt-3" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
          </div>
        <% } %>
      </div>

      <div class="mt-6">
        <a href="/user/nomor-wa" class="btn btn-outline-secondary btn-custom inline-flex items-center px-4 py-2 rounded-lg hover:bg-gray-100">
          <i class="fas fa-arrow-left mr-2"></i> Kembali ke Daftar Nomor
        </a>
      </div>
    </div>
  </div>

  <!-- ✅ Data dari EJS ke JavaScript -->
  <script id="ejs-data" type="application/json">
    {
      "sessionName": "<%= sessionName %>",
      "isConnected": <%= isConnected %>
    }
  </script>

  <!-- ✅ JavaScript untuk real-time status checking -->
  <script>
    // Ambil data dari EJS
    const ejsData = JSON.parse(document.getElementById('ejs-data').textContent);
    const sessionName = ejsData.sessionName;
    let statusCheckInterval;
    let isCurrentlyConnected = ejsData.isConnected;

    // ✅ Fungsi untuk cek status koneksi
    async function checkConnectionStatus() {
      try {
        const response = await fetch(`/user/nomor-wa/status/${sessionName}`);
        const data = await response.json();
        
        // Jika status berubah dari tidak terhubung ke terhubung
        if (!isCurrentlyConnected && data.isConnected) {
          showSuccessNotification();
          isCurrentlyConnected = true;
          clearInterval(statusCheckInterval); // Stop checking
        }
        
        // Jika belum terhubung dan belum ada QR, refresh halaman
        if (!data.isConnected && !document.querySelector('img[alt="QR Code"]') && !isCurrentlyConnected) {
          setTimeout(() => {
            window.location.reload();
          }, 3000);
        }
        
      } catch (error) {
        console.error('Error checking status:', error);
      }
    }

    // ✅ Fungsi untuk menampilkan notifikasi success
    function showSuccessNotification() {
      const statusContainer = document.getElementById('status-container');
      statusContainer.innerHTML = `
        <div class="success-notification">
          <div class="success-icon text-6xl text-green-500 mb-4">
            <i class="fas fa-check-circle"></i>
          </div>
          <p class="text-green-700 font-semibold text-lg">
            ✅ Berhasil terhubung ke WhatsApp!
          </p>
          <div class="bg-green-50 text-green-700 text-sm p-4 rounded-lg mt-4">
            <p><i class="fas fa-info-circle mr-2"></i>Koneksi WhatsApp aktif dan siap digunakan.</p>
          </div>
        </div>
      `;
      
      // ✅ Play sound notification (optional)
      try {
        const audio = new Audio('data:audio/wav;base64,UklGRvIBAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgAZGF0YQoGAACBhYqFbF1fdJivrJBhNjVgodDbq2EcBj+a2/LDciUFLIHO8tiJNwgZaLvt559NEAxQp+PwtmMcBzSH0fPTgjMGJHfH8N2QQAoUXrTp66hVFApGn+DyvmwhBaW1vu+7sWSd1ez'); 
        audio.play().catch(() => {}); // Ignore errors if audio fails
      } catch (e) {}
    }

    // ✅ Fungsi refresh QR
    function refreshQR() {
      window.location.reload();
    }

    // ✅ Start checking status jika belum terhubung
    if (!isCurrentlyConnected) {
      // Check immediately
      checkConnectionStatus();
      
      // Then check every 2 seconds
      statusCheckInterval = setInterval(checkConnectionStatus, 2000);
    }

    // ✅ Cleanup interval saat halaman ditutup
    window.addEventListener('beforeunload', () => {
      if (statusCheckInterval) {
        clearInterval(statusCheckInterval);
      }
    });
  </script>

  <!-- JS Libraries -->
  <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
  // ✅ Fungsi ambil QR realtime
  async function getQrCode() {
    try {
      const res = await fetch(`/user/nomor-wa/qr/${sessionName}`);
      const data = await res.json();

      if (data.status === 'qr_ready' && data.qrImage) {
        // QR tersedia, tampilkan
        const qrSection = document.getElementById('status-container');
        qrSection.innerHTML = `
          <div id="qr-section">
            <img src="${data.qrImage}" alt="QR Code" class="max-w-[250px] mx-auto mb-4 rounded-lg">
            <p class="text-green-600 font-medium mb-3"><i class="fas fa-check-circle mr-2"></i>Silakan scan menggunakan WhatsApp Anda.</p>
            <div class="bg-blue-50 text-blue-700 text-sm p-4 rounded-lg mb-4">
              <p>Buka WhatsApp → Ketuk titik tiga ⋮ → Pilih "Perangkat Tertaut" → Scan QR ini.</p>
            </div>
            <button onclick="refreshQR()" class="btn btn-outline-primary btn-custom inline-flex items-center px-4 py-2 rounded-lg hover:bg-blue-50">
              <i class="fas fa-sync-alt mr-2"></i> Refresh QR Code
            </button>
          </div>
        `;
      } else if (data.status === 'authenticated') {
        // Sudah login, tampilkan notifikasi
        showSuccessNotification();
        clearInterval(qrPolling);
        clearInterval(statusCheckInterval);
      }
    } catch (err) {
      console.error('Gagal mengambil QR:', err);
    }
  }

  // ✅ Polling ambil QR tiap 3 detik
  const qrPolling = setInterval(getQrCode, 3000);
  getQrCode(); // jalankan pertama kali

  // ✅ Bersihkan interval saat keluar halaman
  window.addEventListener('beforeunload', () => {
    clearInterval(qrPolling);
    if (statusCheckInterval) {
      clearInterval(statusCheckInterval);
    }
  });
</script>

</body>
</html>