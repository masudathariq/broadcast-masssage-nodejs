<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Upload Nomor WhatsApp</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  <style>
    .btn-custom {
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .btn-custom:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 15px rgba(0, 123, 255, 0.3);
    }
    .card {
      transform: scale(1);
      transition: transform 0.3s ease;
    }
    .card:hover {
      transform: scale(1.02);
    }
  </style>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center">
    <div class="container mx-auto px-4 py-8">
        <!-- Judul Halaman dengan Ikon -->
        <h2 class="text-3xl font-bold text-gray-800 mb-6 flex items-center">
            <i class="fas fa-file-upload text-blue-500 text-4xl mr-3"></i>
            Upload File Excel Nomor WhatsApp
        </h2>
        <!-- Tombol Kembali -->
        <a href="/dashboard"
           class="btn btn-outline-secondary mb-6 btn-custom inline-flex items-center px-4 py-2 rounded-lg hover:bg-gray-200 transition-colors">
            <i class="fas fa-arrow-left mr-2"></i> Kembali ke Dashboard
        </a>
        <!-- Kartu untuk Form Upload -->
        <div class="card shadow-lg bg-white rounded-xl p-6 max-w-lg mx-auto">
            <div class="card-body">
                <form action="/user/upload" method="POST" enctype="multipart/form-data">
                    <div class="mb-4">
                        <label for="file_excel" class="form-label text-gray-700 font-medium">Pilih File Excel (.xlsx
                            atau .xls):</label>
                        <input type="file"
                               class="form-control mt-2 block w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
                               id="file_excel" name="file_excel" required>
                    </div>
                    <button type="submit"
                            class="btn btn-primary btn-custom w-full mt-4 py-3 rounded-lg bg-blue-600 text-white font-semibold flex items-center justify-center hover:bg-blue-700 transition-colors">
                        <i class="fas fa-upload mr-2"></i> Upload
                    </button>
                </form>
            </div>
        </div>
        <!-- Menyertakan JavaScript -->
        <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>