<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Progress Kirim Pesan</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
  <style>
    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    } 
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes checkmark {
      0% { transform: scale(0); }
      50% { transform: scale(1.2); }
      100% { transform: scale(1); }
    }
    .progress-bar {
      transition: width 0.4s ease;
    }
    .check-icon {
      animation: checkmark 0.5s ease forwards;
    }
    .success-alert {
      animation: fadeIn 0.5s;
    }
  </style>
</head>
<body class="bg-gray-100 font-sans min-h-screen flex items-center justify-center">
  <div class="container max-w-lg mx-auto p-6 bg-white rounded-2xl shadow-xl">
    <h2 class="text-2xl font-bold text-gray-800 mb-6 flex items-center justify-center">
      <i class="fas fa-paper-plane mr-2"></i> Progress Pengiriman Pesan
    </h2>

    <!-- ALERT ERROR -->
    <div id="errorAlert" class="hidden bg-red-100 border-l-4 border-red-500 text-red-700 p-4 rounded-lg mb-4" role="alert"></div>

    <!-- ALERT SUCCESS -->
    <div id="successAlert" class="hidden bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded-lg mb-4 success-alert" role="alert">
      <i class="fas fa-check-circle check-icon mr-2"></i> Pengiriman pesan selesai!
    </div>

    <div class="relative w-full h-6 bg-gray-200 rounded-full overflow-hidden mb-4">
      <div id="progressBar" class="progress-bar h-full bg-blue-600 text-white text-xs font-medium flex items-center justify-center" style="width: 0%;">0%</div>
    </div>

    <div id="loadingAnimation" class="hidden text-center mb-4">
      <i class="fas fa-spinner text-blue-600 text-3xl animate-spin"></i>
      <p class="text-gray-600 mt-2">Loading, harap tunggu...</p>
    </div>

    <div class="text-center text-gray-700 mb-4">
      <p><strong>Terkirim:</strong> <span id="sukses">0</span> | 
         <strong>Gagal:</strong> <span id="gagal">0</span> | 
         <strong>Total:</strong> <span id="total">0</span></p>
      <p id="status" class="text-sm text-gray-500 mt-2">Status: idle</p>
    </div>

    <a href="/dashboard" class="block w-full text-center bg-gray-600 text-white py-2 px-4 rounded-lg hover:bg-gray-700 transition duration-200">
      <i class="fas fa-arrow-left mr-2"></i> Kembali ke Dashboard
    </a>
  </div>

  <script>
    async function fetchProgress() {
      const res = await fetch('/user/progress');
      const data = await res.json();

      const persen = data.total > 0 ? ((data.sukses + data.gagal) / data.total * 100).toFixed(0) : 0;

      document.getElementById('sukses').textContent = data.sukses;
      document.getElementById('gagal').textContent = data.gagal;
      document.getElementById('total').textContent = data.total;

      if (data.error) {
        document.getElementById('status').style.display = 'none';
      } else {
        document.getElementById('status').style.display = 'block';
        document.getElementById('status').textContent = 'Status: ' + data.status;
      }

      document.getElementById('progressBar').style.width = persen + '%';
      document.getElementById('progressBar').textContent = persen + '%';

      document.getElementById('loadingAnimation').style.display = 'block';

      if (data.error) {
        const alert = document.getElementById('errorAlert');
        alert.textContent = data.error;
        alert.classList.remove('hidden');
        alert.classList.add('show');
      }

      if (data.status === 'selesai') {
        document.getElementById('progressBar').classList.remove('progress-bar-animated');
        document.getElementById('loadingAnimation').style.display = 'none';
        clearInterval(progressInterval);

        if (!data.error) {
          const successAlert = document.getElementById('successAlert');
          successAlert.style.display = 'block';

          setTimeout(() => {
            successAlert.style.display = 'none';
          }, 5000);
        }
      }
    }

    const progressInterval = setInterval(fetchProgress, 2000);
    fetchProgress();
  </script>
</body>
</html>