<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Log WhatsApp</title>
  <link href="https://cdn.tailwindcss.com" rel="stylesheet">
</head>
<body class="bg-gray-100 p-8">
  <h1 class="text-2xl font-bold mb-4">📋 Log Sistem WhatsApp</h1>
  <a href="/admin/dashboard" class="text-blue-600 underline mb-4 inline-block">← Kembali ke Dashboard</a>

  <div class="bg-white p-4 rounded shadow-md max-h-screen overflow-auto text-sm font-mono">
    <% if (logs.length === 0) { %>
      <p class="text-gray-600">Belum ada log.</p>
    <% } else { %>
      <ul class="space-y-1">
        <% logs.forEach(log => { %>
          <li><%= log %></li>
        <% }) %>
      </ul>
    <% } %>
  </div>
</body>
</html>
